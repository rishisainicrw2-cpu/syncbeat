# Copy to server/.env (local) or set as platform environment variables (production).

NODE_ENV=production
PORT=4000

# REQUIRED in production. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Optional. Without it SYNCBEAT uses an in-memory store (accounts/rooms vanish on restart).
# DATABASE_URL=postgres://syncbeat:syncbeat@localhost:5432/syncbeat

# Where uploaded audio is stored (mount a persistent disk/volume here in production).
DATA_DIR=./data

# Built PWA to serve (single-origin deploy). Default works for the monorepo layout.
# WEB_DIST=../web/dist

# Only needed if the web app is hosted on a different origin than the API (comma-separated).
# CLIENT_ORIGIN=https://app.example.com

# Number of reverse proxies in front of the server (needed for correct rate-limit IPs). Default 1 in production.
# TRUST_PROXY=1

MAX_UPLOAD_MB=40
MAX_TRACKS_PER_ROOM=100
MAX_MEMBERS_PER_ROOM=50
DEFAULT_LEAD_MS=2000
